<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rezona_widget_pill_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/widget_compact_cover"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_rezona_logo"
        android:background="#22FFFFFF"
        android:contentDescription="Album cover" />

    <LinearLayout
        android:id="@+id/widget_compact_meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_compact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rezona"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_compact_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to open player"
            android:textColor="#B8FFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_compact_like"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_heart_outline"
        android:contentDescription="Like" />

    <ImageButton
        android:id="@+id/widget_compact_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_play_arrow"
        android:tint="#FFFFFFFF"
        android:contentDescription="Play or Pause" />

    <ImageButton
        android:id="@+id/widget_compact_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_skip_next"
        android:tint="#FFFFFFFF"
        android:contentDescription="Next" />
</LinearLayout>
