<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rezona_widget_glass_bg"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_rezona_logo"
        android:background="#22FFFFFF"
        android:contentDescription="Album cover" />

    <ImageButton
        android:id="@+id/widget_btn_like"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:src="@drawable/ic_heart_outline"
        android:contentDescription="Like song" />

    <LinearLayout
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_cover"
        android:layout_toStartOf="@id/widget_btn_like"
        android:layout_alignTop="@id/widget_cover"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rezona"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap to play music"
            android:textColor="#B8FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/rezona_widget_progress" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentBottom="true"
        android:layout_below="@id/widget_cover"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_skip_previous"
            android:tint="#FFFFFFFF"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/widget_btn_play"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_play_arrow"
            android:tint="#FFFFFFFF"
            android:contentDescription="Play or Pause" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_skip_next"
            android:tint="#FFFFFFFF"
            android:contentDescription="Next" />
    </LinearLayout>
</RelativeLayout>
