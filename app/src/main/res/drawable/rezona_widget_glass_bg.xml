<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep translucent dark frosted base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#CC2B313B"
                android:centerColor="#D6191D24"
                android:endColor="#E0101217" />
        </shape>
    </item>
    <!-- Specular white glass rim highlight along top/sides -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#52FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
